# Server
PORT=3000
HOST=0.0.0.0
BASE_URL=http://localhost:3000
PLATFORM_URL=http://localhost:5173

# Auth
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI (OpenAI-compatible)
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
TURN_TIMEOUT_MS=900000

# Agent sessions (libfx). Defaults to apps/api/.fx/sessions.
# FX_SESSIONS_DIR=

# Preview origins. Use host names only; the port is appended for *.localhost.
PREVIEW_DOMAIN=preview.localhost
PUBLIC_DOMAIN=localhost
PUBLIC_SCHEME=http
# PUBLIC_PORT=3000
PREVIEW_TOKEN_SECRET=change-me-to-a-random-32-char-string
